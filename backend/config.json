{
    "type": "Settings",
    "audio": {
        "input": {
            "encoding": "mulaw",
            "sample_rate": 8000
        },
        "output": {
            "encoding": "mulaw",
            "sample_rate": 8000,
            "container": "none"
        }
    },
    "agent": {
        "language": "hi",
        "listen": {
            "provider": {
                "type": "deepgram",
                "model": "nova-3",
                "language": "hi",
                "keyterms": [
                    "सोलर",
                    "सोलर पैनल",
                    "किस्त",
                    "साइट सर्वे",
                    "बिजली का बिल",
                    "यूनिट"
                ]
            }
        },
        "think": {
            "provider": {
                "type": "open_ai",
                "model": "gpt-4o-mini",
                "temperature": 0.3
            }
        },
        "speak": {
            "provider": {
                "type": "deepgram",
                "version": "v2",
                "model": "flux-anjali-hi"
            }
        }
    }
}